# DayDayUp DSH fork 更新工具配置。被脚本 source/解析，可用同名环境变量覆盖。
FORK_APP_NAME="DayDayUp DSH"
FORK_APP_ID="com.saber.daydayupdsh"
FORK_CHANNEL="all"            # all: 跟正式版+alpha/rc；stable: 只跟正式版
FORK_KEEP_BACKUPS=3           # ~/.dsh 备份保留份数
FORK_PUSH_ORIGIN=1            # 更新成功后是否自动推送 origin
FORK_WORKTREE="/Volumes/saber/dsh-build"  # 打包 worktree（系统卷紧张，放大数据卷）
FORK_MIN_FREE_GB=20           # self-update 前置磁盘检查阈值（build 卷）
