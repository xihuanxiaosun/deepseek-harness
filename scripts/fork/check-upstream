#!/usr/bin/env node
/**
 * check-upstream — 只读检测上游 deepseek-harness 的新发布 tag，分析变更与合并冲突。
 *
 * 在任意本仓库 checkout 内运行（以当前 HEAD 为基准）：
 *   scripts/fork/check-upstream            人类可读中文摘要
 *   scripts/fork/check-upstream --json     输出纯 JSON（供 dsh 内功能读取）
 *   scripts/fork/check-upstream --json-file <path>
 *   scripts/fork/check-upstream --channel all|stable
 *
 * 不修改工作区；冲突预演用 `git merge-tree --write-tree`，不产生任何合并提交。
 */
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'

const REPO = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim()

function loadConfig() {
  const cfg = { FORK_CHANNEL: 'all' }
  const file = path.join(REPO, 'scripts', 'fork', 'config.env')
  try {
    for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
      const m = line.match(/^\s*(FORK_[A-Z_]+)\s*=\s*"?([^"\s#]+)"?/)
      if (m) cfg[m[1]] = m[2]
    }
  } catch {}
  return cfg
}

function git(args, { allowFail = false } = {}) {
  try {
    return { out: execFileSync('git', args, { cwd: REPO, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'] }), code: 0 }
  } catch (e) {
    if (!allowFail) { process.stderr.write((e.stderr || '').toString()); throw e }
    return { out: (e.stdout || '').toString(), code: e.status ?? 1 }
  }
}

// dsh-vMAJOR.MINOR.PATCH[-stage.N]；正式版 stage 视为 final，排序在 rc 之后。
const TAG_RE = /^dsh-v(\d+)\.(\d+)\.(\d+)(?:-(alpha|beta|rc)\.(\d+))?$/
function parseTag(tag) {
  const m = TAG_RE.exec(tag)
  if (!m) return null
  const stageRank = { alpha: 0, beta: 1, rc: 2, final: 3 }[m[4] ?? 'final']
  return { tag, major: +m[1], minor: +m[2], patch: +m[3], stage: m[4] ?? 'final', stageNum: m[4] ? +m[5] : 0, stageRank }
}
function cmpTag(a, b) {
  return a.major - b.major || a.minor - b.minor || a.patch - b.patch ||
    a.stageRank - b.stageRank || a.stageNum - b.stageNum
}
function isPrerelease(p) { return p.stageRank < 3 }

function main() {
  const cfg = loadConfig()
  let channel = process.env.FORK_CHANNEL || cfg.FORK_CHANNEL || 'all'
  let jsonPath = null
  const argv = process.argv.slice(2)
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--json') jsonPath = '-'
    else if (argv[i] === '--json-file') jsonPath = argv[++i] ?? ''
    else if (argv[i] === '--channel') channel = argv[++i] ?? ''
    else if (argv[i] === '--help' || argv[i] === '-h') {
      console.log('用法: check-upstream [--json] [--json-file <path>] [--channel all|stable]')
      console.log('只读检测上游新发布 tag、变更摘要与合并冲突预演。--json 输出纯 JSON。')
      return
    } else { console.error(`未知参数: ${argv[i]}（见 --help）`); process.exit(2) }
  }
  if (channel !== 'all' && channel !== 'stable') { console.error(`--channel 只支持 all|stable，收到: ${channel}`); process.exit(2) }

  const tags = git(['tag', '--list', 'dsh-v*']).out.split('\n').map(parseTag).filter(Boolean)
  if (!tags.length) { console.error('仓库中没有任何 dsh-v* tag，请先 git fetch upstream --tags'); process.exit(1) }

  // 基准 = 已是 HEAD 祖先的最新发布 tag
  const ancestors = tags.filter(p => git(['merge-base', '--is-ancestor', p.tag, 'HEAD'], { allowFail: true }).code === 0)
  const base = ancestors.sort(cmpTag).at(-1) ?? null
  const pool = tags.filter(p => channel === 'all' || !isPrerelease(p))
  const latest = pool.sort(cmpTag).at(-1)
  if (!latest) { console.error('过滤通道后没有可用 tag'); process.exit(1) }

  let report = {
    ok: true, repo: REPO, channel,
    current_base_tag: base?.tag ?? null, latest_tag: latest.tag, update_available: false,
    commits_ahead: 0, log_summary: [], changed_files: [], changed_files_total: 0,
    upgrade_guide: null, conflicts: [], merge_tree_ok: null, recommendation: 'none',
    generated_at: new Date().toISOString(),
  }
  if (!base || cmpTag(latest, base) <= 0) {
    report.note = '当前已是该通道最新版本'
  } else {
    report.update_available = true
    report.commits_ahead = +git(['rev-list', '--count', `${base.tag}..${latest.tag}`]).out.trim()
    report.log_summary = git(['log', '--oneline', '--no-decorate', `${base.tag}..${latest.tag}`]).out.trim().split('\n').slice(0, 40)
    const files = git(['diff', '--name-only', `${base.tag}..${latest.tag}`]).out.trim().split('\n').filter(Boolean)
    report.changed_files_total = files.length
    report.changed_files = files.slice(0, 200)
    const guidePath = `docs/upgrade-guide/v${latest.tag.slice('dsh-v'.length)}`
    report.upgrade_guide = git(['cat-file', '-e', `${latest.tag}:${guidePath}`], { allowFail: true }).code === 0 ? guidePath : null
    const mt = git(['merge-tree', '--write-tree', '--name-only', 'HEAD', latest.tag], { allowFail: true })
    report.merge_tree_ok = mt.code === 0
    report.conflicts = mt.code === 0 ? [] : mt.out.split('\n').slice(1).map(s => s.trim()).filter(Boolean)
    report.recommendation = mt.code === 0 ? 'update' : 'manual'
  }

  if (jsonPath) {
    const text = JSON.stringify(report, null, 2)
    if (jsonPath === '-') process.stdout.write(text + '\n')
    else { fs.mkdirSync(path.dirname(jsonPath), { recursive: true }); fs.writeFileSync(jsonPath, text + '\n') }
  }
  if (!jsonPath || process.stderr.isTTY || jsonPath !== '-') {
    const c = console
    c.log(`== DayDayUp DSH 上游更新检测 ==`)
    c.log(`基准 tag: ${report.current_base_tag ?? '（无）'}；通道: ${channel === 'all' ? '正式版 + alpha/rc' : '仅正式版'}`)
    if (!report.update_available) { c.log('当前已是最新，无需更新。'); return }
    c.log(`最新 tag: ${report.latest_tag}（领先 ${report.commits_ahead} 个提交，变更文件 ${report.changed_files_total} 个）`)
    c.log(`升级说明: ${report.upgrade_guide ?? '（该版本暂无 docs/upgrade-guide）'}`)
    c.log(`冲突预演: ${report.merge_tree_ok ? '无冲突，可自动更新' : '存在冲突：\n  ' + report.conflicts.join('\n  ')}`)
    c.log(`建议: ${report.recommendation === 'update' ? '建议更新（scripts/fork/self-update ' + report.latest_tag + '）' : '不建议自动更新，需手动合并解决冲突'}`)
    c.log(`--- 提交摘要（前 ${report.log_summary.length} 条）---`)
    for (const l of report.log_summary) c.log('  ' + l)
  }
}

main()
